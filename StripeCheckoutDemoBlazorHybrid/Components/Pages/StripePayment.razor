@* @namespace StripeCheckoutDemoBlazorHybrid.Components.Pages
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<div class="payment-container">
    <div class="payment-form">
        <div class="form-row">
            <label for="card-element">Credit or debit card</label>
            <div id="card-element"></div>
            <div id="card-errors" role="alert"></div>
        </div>

        <button class="pay-button" @onclick="HandleSubmit" disabled="@isProcessing">
            @if (isProcessing)
            {
                <span class="spinner"></span>
                <span>Processing...</span>
            }
            else
            {
                <span>Pay @Amount.ToString("C", new System.Globalization.CultureInfo("en-GB"))</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public string Description { get; set; }
    [Parameter] public EventCallback<string> OnPaymentComplete { get; set; }

    private bool isProcessing = false;
    private string clientSecret;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeStripe();
        }
    }

    private async Task InitializeStripe()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("checkout/create-payment-intent", new
            {
                amount = Amount,
                description = Description
            });

            if (!response.IsSuccessStatusCode)
            {
                throw new Exception($"Failed to create payment intent: {response.StatusCode}");
            }

            var result = await response.Content.ReadFromJsonAsync<PaymentIntentResponse>();
            clientSecret = result.ClientSecret;

            var initialized = await JSRuntime.InvokeAsync<bool>("initializeStripe", clientSecret);
            if (!initialized)
            {
                throw new Exception("Failed to initialize Stripe");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Initialization error: {ex.Message}");
        }
    }

    private async Task HandleSubmit()
    {
        isProcessing = true;
        try
        {
            var resultJson = await JSRuntime.InvokeAsync<string>("confirmPayment");
            if (string.IsNullOrEmpty(resultJson))
            {
                throw new Exception("No response from payment confirmation");
            }

            var result = System.Text.Json.JsonSerializer.Deserialize<StripePaymentResult>(resultJson);
            
            if (result.Error != null)
            {
                await JSRuntime.InvokeVoidAsync("alert", result.Error);
            }
            else
            {
                await OnPaymentComplete.InvokeAsync(result.PaymentIntentId);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Payment error: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private class PaymentIntentResponse
    {
        public string ClientSecret { get; set; }
    }

    private class StripePaymentResult
    {
        public string PaymentIntentId { get; set; }
        public string Error { get; set; }
    }
}  *@