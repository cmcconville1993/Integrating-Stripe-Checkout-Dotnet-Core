@page "/"

@* <h1>Hello, world!</h1>

Welcome to your new app. *@

@inject HttpClient Http

<h3>Stripe Checkout</h3>

<input @bind="checkoutForm.ProductName" placeholder="Product Name" />
<input @bind="checkoutForm.ProductDescription" placeholder="Product Description" />
<input @bind="checkoutForm.Amount" type="number" placeholder="Amount" />
<input @bind="checkoutForm.Currency" placeholder="Currency" />

<button @onclick="StartCheckout">Pay with Stripe</button>

<p>@responseMessage</p>

@code {
    private StripeCheckoutDemo.Models.CheckoutFormModel checkoutForm = new StripeCheckoutDemo.Models.CheckoutFormModel
    {
        ProductName = "Test Product",
        ProductDescription = "Sample Description",
        Amount = 5000,
        Currency = "USD"
    };

    private string responseMessage = "Waiting for response...";

    private async Task StartCheckout()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("checkout/create-checkout-session", checkoutForm);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CheckoutResponse>();
                @* string stripeUrl = $"https://checkout.stripe.com/c/pay/{result.sessionId}"; *@
                string stripeUrl = $"{result.checkoutUrl}";

                await Launcher.OpenAsync(stripeUrl); // Open Stripe Checkout
                responseMessage = "Redirecting to Stripe...";
            }
            else
            {
                responseMessage = "Error: " + response.ReasonPhrase;
            }
        }
        catch (Exception ex)
        {
            responseMessage = "Exception: " + ex.Message;
        }
    }

    @* private class CheckoutFormModel
    {
        public string? ProductName { get; set; }
        public string? ProductDescription { get; set; }
        public long Amount { get; set; }
        public string? Currency { get; set; }
    } *@

    private class CheckoutResponse
    {
        public string sessionId { get; set; }
        public string returnUrl { get; set; }
        public string checkoutUrl { get; set; }
    }
}
